// Cloudflare Workers config: serves the Vite build output (dist/) as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mysite", // must match the Worker name in the Cloudflare dashboard
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
